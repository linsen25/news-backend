  "info": {
    "title": "News Platform API",
    "description": "Mock-backed CMS contract for authentication, articles, review workflow, users and audit logs.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": ""
    },
    {
      "name": "Articles",
      "description": ""
    },
    {
      "name": "Review",
      "description": ""
    },
    {
      "name": "Users",
      "description": ""
    },
    {
      "name": "Audit",
      "description": ""
    },
    {
      "name": "Upload",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "jwt": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "author@example.com"
          },
          "password": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "PermissionDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "articles.submit"
          },
          "module": {
            "type": "string",
            "enum": [
              "articles.edit",
              "articles.review",
              "accounts.manage"
            ],
            "example": "articles.edit"
          },
          "description": {
            "type": "string",
            "example": "提交审核"
          }
        },
        "required": [
          "key",
          "module",
          "description"
        ]
      },
      "RoleDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "role-author"
          },
          "name": {
            "type": "string",
            "enum": [
              "Author",
              "Reviewer",
              "Admin"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PermissionDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "permissions"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "user-author"
          },
          "username": {
            "type": "string",
            "example": "林作者",
            "description": "Display username"
          },
          "email": {
            "type": "string",
            "example": "author@example.com"
          },
          "role": {
            "$ref": "#/components/schemas/RoleDto"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PermissionDto"
            }
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "role",
          "permissions"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "EntityReferenceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "user-author"
          },
          "name": {
            "type": "string",
            "example": "林作者"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "ArticleReferenceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "article-001"
          },
          "title": {
            "type": "string",
            "example": "生成式 AI 正在改变新闻编辑流程"
          }
        },
        "required": [
          "id",
          "title"
        ]
      },
      "AuditLogDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "audit-001"
          },
          "user": {
            "$ref": "#/components/schemas/EntityReferenceDto"
          },
          "action": {
            "type": "string",
            "enum": [
              "CREATE_ARTICLE",
              "UPDATE_ARTICLE",
              "SUBMIT_REVIEW",
              "APPROVE_ARTICLE",
              "REJECT_ARTICLE",
              "PUBLISH_ARTICLE",
              "DELETE_ARTICLE",
              "LOGIN"
            ]
          },
          "article": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ArticleReferenceDto"
              }
            ]
          },
          "description": {
            "type": "string",
            "example": "提交文章审核"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "user",
          "action",
          "description",
          "createdAt"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "TipTapMarkDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "bold"
          },
          "attrs": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "type"
        ]
      },
      "TipTapNodeDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "paragraph"
          },
          "attrs": {
            "type": "object",
            "additionalProperties": true
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TipTapNodeDto"
            }
          },
          "marks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TipTapMarkDto"
            }
          },
          "text": {
            "type": "string",
            "example": "正文内容"
          }
        },
